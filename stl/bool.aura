// stl/bool.aura — Boolean type definition and utilities for Aura.
//
// `Bool` is an enum with two unit variants.
// Variant tag order is significant: `false` is tag 0, `true` is tag 1.
// This mirrors the design spec: Bool = enum(false: (), true: ()).
//
// The prelude globals `true` and `false` are seeded as `Value::Bool` by the VM
// before any Aura source is executed; they do not need to be re-exported here.

// ─────────────────────────────────────────────────────────────────────────────
// Type definition
// ─────────────────────────────────────────────────────────────────────────────

/// The boolean type.  Variant order: `false` = tag 0, `true` = tag 1.
def Bool = enum(false: (), true: ());

// ─────────────────────────────────────────────────────────────────────────────
// Utility functions
// ─────────────────────────────────────────────────────────────────────────────

/// Returns the logical negation of `b`.
def Bool.not(self: Bool) -> Bool {
    {
        .true -> .false,
        .false -> .true,
    }(self)
}

/// Returns `true` if both `self` and `other` are `true`.
def Bool.and(self: Bool, other: Bool) -> Bool {
    {
        .true -> other,
        .false -> .false,
    }(self)
}

/// Returns `true` if either `self` or `other` is `true`.
def Bool.or(self: Bool, other: Bool) -> Bool {
    {
        .true -> .true,
        .false -> other,
    }(self)
}

/// Converts the boolean to its string representation ("true" or "false").
def Bool.toString(self: Bool) -> String {
    {
        .true -> "true",
        .false -> "false",
    }(self)
}
