def[T, E] Result = enum(err: E, ok: T);

def[T, E] Result.is_ok(self: Result[T, E]) -> Bool {
    {
        .ok(_) -> .true,
        _ -> .false,
    }(self)
}

def[T, E] Result.is_err(self: Result[T, E]) -> Bool {
    !self.is_ok()
}

def[T, E] Result.ok(self: Result[T, E]) -> Any {
    {
        .ok(v) -> .some(v),
        _ -> .null,
    }(self)
}

def[T, E] Result.err(self: Result[T, E]) -> Any {
    {
        .err(e) -> .some(e),
        _ -> .null,
    }(self)
}

def[T, E] Result.unwrap(self: Result[T, E]) -> T {
    {
        .ok(v) -> v,
        _ -> panic("unwrap called on Err"),
    }(self)
}

def[T, E] Result.unwrap_or(self: Result[T, E], default: T) -> T {
    {
        .ok(v) -> v,
        _ -> default,
    }(self)
}

def[T, E] Result.unwrap_or_else(self: Result[T, E], default: Func[(), T]) -> T {
    {
        .ok(v) -> v,
        _ -> default(),
    }(self)
}

def[T, E] Result.unwrap_err(self: Result[T, E]) -> E {
    {
        .err(e) -> e,
        _ -> panic("unwrap_err called on Ok"),
    }(self)
}

def[T, E] Result.unwrap_err_or(self: Result[T, E], default: E) -> E {
    {
        .err(e) -> e,
        _ -> default,
    }(self)
}

def[T, E] Result.unwrap_err_or_else(self: Result[T, E], default: Func[(), E]) -> E {
    {
        .err(e) -> e,
        _ -> default(),
    }(self)
}

def[T, E, U] Result.map(self: Result[T, E], f: Func[T, U]) -> Result[U, E] {
    {
        .ok(v) -> .ok(f(v)),
        .err(e) -> .err(e),
    }(self)
}

def[T, E, F] Result.map_err(self: Result[T, E], f: Func[E, F]) -> Result[T, F] {
    {
        .ok(v) -> .ok(v),
        .err(e) -> .err(f(e)),
    }(self)
}

def[T, E, U, F] Result.and_then(self: Result[T, E], f: Func[T, Result[U, F]]) -> Result[U, F] {
    {
        .ok(v) -> f(v),
        .err(e) -> .err(e),
    }(self)
}

def[T, E, F] Result.or_else(self: Result[T, E], f: Func[E, Result[T, F]]) -> Result[T, F] {
    {
        .ok(v) -> .ok(v),
        .err(e) -> f(e),
    }(self)
}
