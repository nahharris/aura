// stl/core.aura — Core general-purpose utilities for Aura.
//
// These functions are thin but give names to common patterns, making
// call-site intent explicit and enabling point-free and pipeline styles.

// ─────────────────────────────────────────────────────────────────────────────
// Pattern dispatch
// ─────────────────────────────────────────────────────────────────────────────

/// Apply a pattern-matching closure to `value` (`f(value)`).
///
/// Pattern matching uses the same multi-arm closure syntax as everywhere else:
///
///   {
///       200 -> "ok",
///       404 -> "not found",
///       n   -> "other: $(n)",
///   }(status)
///
/// The parameter label `with` names the closure argument for readable calls:
/// `match(status, f with: { ... })`.
def[T, U] match(value: T, f with: Func[T, U]) -> U { f(value) }
